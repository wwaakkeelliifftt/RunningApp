<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/setupFragment">

    <action
        android:id="@+id/action_global_tracking_fragment"
        app:destination="@id/trackingFragment"
        app:launchSingleTop="true" />
    <!--
    launchSingleTop == true -> block launch new instance of our activity with reinitialize of state
     and drop off current data
    -->


    <fragment
        android:id="@+id/runFragment"
        android:name="com.example.runningapp.ui.fragments.RunFragment"
        android:label="RunFragment" >
        <action
            android:id="@+id/action_runFragment_to_trackingFragment"
            app:destination="@id/trackingFragment" />
    </fragment>

    <fragment
        android:id="@+id/setupFragment"
        android:name="com.example.runningapp.ui.fragments.SetupFragment"
        android:label="SetupFragment" >
        <action
            android:id="@+id/action_setupFragment_to_runFragment"
            app:destination="@id/runFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.runningapp.ui.fragments.SettingsFragment"
        android:label="SettingsFragment">
<!--    solve case with popUp fragment from backstack in xml, without navOption -->
        <action
            android:id="@+id/action_settingsFragment_to_setupFragment"
            app:destination="@id/setupFragment"
            app:popUpTo="@id/settingsFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.runningapp.ui.fragments.StatisticsFragment"
        android:label="StatisticsFragment" />

    <fragment
        android:id="@+id/trackingFragment"
        android:name="com.example.runningapp.ui.fragments.TrackingFragment"
        android:label="TrackingFragment" >
        <action
            android:id="@+id/action_trackingFragment_to_runFragment"
            app:destination="@id/runFragment" />
    </fragment>

</navigation>